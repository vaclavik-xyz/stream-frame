[Unit]
Description=vrstream — live VR compositor stream (HLS + RTSP/WebRTC)
Documentation=https://github.com/USER/vrstream
After=network-online.target steamvr.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/vrstream/server
ExecStart=@PYTHON@ %h/vrstream/server/vrstreamd.py --bitrate 4M
Restart=always
RestartSec=3
# give the encoder time to finish the segment and exit cleanly
KillSignal=SIGTERM
TimeoutStopSec=10
Environment=VRSTREAM_IDLE=120

[Install]
WantedBy=default.target
