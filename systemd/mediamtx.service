[Unit]
Description=MediaMTX — RTSP/WebRTC server for Stream Frame
After=network-online.target streamframe.service
Wants=network-online.target
PartOf=streamframe.service

[Service]
Type=simple
WorkingDirectory=%h/stream-frame
ExecStart=%h/stream-frame/bin/mediamtx %h/stream-frame/config/mediamtx.yml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
